{
  "name": "pronounciation",
  "displayName": "Pronunciation",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0566ed",
    "theme": "dark"
  },
  "description": "Read text aloud with local voices or configurable TTS APIs, adjustable speed, and replay.",
  "version": "0.0.2",
  "repository": "https://github.com/zznam/vs-pronounciation.git",
  "homepage": "https://github.com/zznam/vs-pronounciation#readme",
  "bugs": {
    "url": "https://github.com/zznam/vs-pronounciation/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=22.13.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "text to speech",
    "tts",
    "pronunciation",
    "read aloud",
    "accessibility",
    "openai",
    "elevenlabs"
  ],
  "activationEvents": [
    "onCommand:pronounciation.pronounce",
    "onCommand:pronounciation.readLine",
    "onCommand:pronounciation.readParagraph",
    "onCommand:pronounciation.readDocument",
    "onCommand:pronounciation.readAllSelections",
    "onCommand:pronounciation.readInput",
    "onCommand:pronounciation.readClipboard",
    "onCommand:pronounciation.clearReplay",
    "onCommand:pronounciation.stop",
    "onCommand:pronounciation.repeat",
    "onCommand:pronounciation.setSpeed",
    "onCommand:pronounciation.setVoice",
    "onCommand:pronounciation.previewVoice",
    "onCommand:pronounciation.setCustomSpeed",
    "onCommand:pronounciation.faster",
    "onCommand:pronounciation.slower",
    "onCommand:pronounciation.resetSpeed",
    "onCommand:pronounciation.openSettings",
    "onCommand:pronounciation.manageTtsConnections",
    "onCommand:pronounciation.chooseTtsConnection",
    "onCommand:pronounciation.setApiKey",
    "onCommand:pronounciation.removeApiKey",
    "onCommand:pronounciation.testTtsConnection"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pronounciation.pronounce",
        "title": "Pronunciation: Read Selection or Word"
      },
      {
        "command": "pronounciation.readLine",
        "title": "Pronunciation: Read Current Line"
      },
      {
        "command": "pronounciation.readParagraph",
        "title": "Pronunciation: Read Current Paragraph"
      },
      {
        "command": "pronounciation.readDocument",
        "title": "Pronunciation: Read Entire Document"
      },
      {
        "command": "pronounciation.readAllSelections",
        "title": "Pronunciation: Read All Selections"
      },
      {
        "command": "pronounciation.readInput",
        "title": "Pronunciation: Read Typed Text"
      },
      {
        "command": "pronounciation.readClipboard",
        "title": "Pronunciation: Read Clipboard"
      },
      {
        "command": "pronounciation.clearReplay",
        "title": "Pronunciation: Clear Replay Text"
      },
      {
        "command": "pronounciation.stop",
        "title": "Pronunciation: Stop"
      },
      {
        "command": "pronounciation.repeat",
        "title": "Pronunciation: Replay Last Text"
      },
      {
        "command": "pronounciation.setSpeed",
        "title": "Pronunciation: Set Speed"
      },
      {
        "command": "pronounciation.setVoice",
        "title": "Pronunciation: Choose Voice"
      },
      {
        "command": "pronounciation.previewVoice",
        "title": "Pronunciation: Preview Voice"
      },
      {
        "command": "pronounciation.setCustomSpeed",
        "title": "Pronunciation: Set Custom Speed"
      },
      {
        "command": "pronounciation.faster",
        "title": "Pronunciation: Speak Faster"
      },
      {
        "command": "pronounciation.slower",
        "title": "Pronunciation: Speak Slower"
      },
      {
        "command": "pronounciation.resetSpeed",
        "title": "Pronunciation: Reset Speed"
      },
      {
        "command": "pronounciation.openSettings",
        "title": "Pronunciation: Open Settings"
      },
      {
        "command": "pronounciation.manageTtsConnections",
        "title": "Pronunciation: Manage TTS Connections"
      },
      {
        "command": "pronounciation.chooseTtsConnection",
        "title": "Pronunciation: Choose TTS Connection"
      },
      {
        "command": "pronounciation.setApiKey",
        "title": "Pronunciation: Set API Key"
      },
      {
        "command": "pronounciation.removeApiKey",
        "title": "Pronunciation: Remove API Key"
      },
      {
        "command": "pronounciation.testTtsConnection",
        "title": "Pronunciation: Test Connection"
      }
    ],
    "keybindings": [
      {
        "command": "pronounciation.pronounce",
        "key": "ctrl+alt+p",
        "mac": "cmd+ctrl+p",
        "when": "editorTextFocus"
      },
      {
        "command": "pronounciation.stop",
        "key": "ctrl+alt+s",
        "mac": "cmd+ctrl+s",
        "when": "editorTextFocus"
      },
      {
        "command": "pronounciation.repeat",
        "key": "ctrl+alt+r",
        "mac": "cmd+ctrl+r",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pronounciation.pronounce",
          "group": "9_cutcopypaste@100"
        },
        {
          "command": "pronounciation.readAllSelections",
          "when": "editorHasMultipleSelections",
          "group": "9_cutcopypaste@100"
        },
        {
          "command": "pronounciation.readLine",
          "group": "9_cutcopypaste@100"
        },
        {
          "command": "pronounciation.readParagraph",
          "group": "9_cutcopypaste@100"
        },
        {
          "command": "pronounciation.stop",
          "when": "pronounciation.speaking",
          "group": "9_cutcopypaste@101"
        }
      ]
    },
    "configuration": {
      "title": "Pronunciation",
      "properties": {
        "pronounciation.voice": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Installed system voice name. Leave empty for the default. On Linux, use a Festival name such as voice_kal_diphone."
        },
        "pronounciation.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 3,
          "scope": "application",
          "description": "Relative speaking speed (0.5 is slower, 1 is normal, 2 is faster). Exact timing depends on the system voice."
        },
        "pronounciation.readWordAtCursor": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Read the word at the cursor when no text is selected."
        },
        "pronounciation.maxTextLength": {
          "type": "integer",
          "default": 50000,
          "minimum": 1,
          "maximum": 50000,
          "scope": "window",
          "description": "Maximum characters in a requested or prepared passage. Lower this to prevent accidental long playback."
        },
        "pronounciation.speakCodeIdentifiers": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Split camelCase, acronym boundaries, and snake_case before reading. URLs and paths are preserved."
        },
        "pronounciation.normalizeWhitespace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Collapse line breaks and repeated whitespace before speaking."
        },
        "pronounciation.replacements": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Literal, case-sensitive whole-word pronunciation replacements, for example {\"SQL\": \"sequel\"}. Applied once before identifier splitting."
        },
        "pronounciation.tts.activeProfile": {
          "type": "string",
          "default": "local",
          "scope": "machine",
          "description": "TTS connection ID for the next read or replay. local uses offline system speech."
        },
        "pronounciation.tts.profiles": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "description": "Saved TTS connections. Manage these with Manage TTS Connections. API keys are stored separately in encrypted SecretStorage.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "provider",
              "model",
              "voice",
              "speed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "elevenlabs",
                  "custom"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "voice": {
                "type": "string",
                "minLength": 1
              },
              "speed": {
                "type": "number",
                "default": 1,
                "minimum": 0.25,
                "maximum": 3,
                "description": "ElevenLabs uses 0.7–1.2. Other connections use 0.25–3."
              },
              "endpoint": {
                "type": "string",
                "description": "Complete custom speech URL. HTTPS, or HTTP on localhost. Requires OpenAI-compatible requests and WAV responses."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration/run.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=extension.js --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 test/*.test.js",
    "check": "npm run lint && npm run test:coverage",
    "package": "node scripts/package.js",
    "verify:package": "node scripts/verify-vsix.js artifacts/pronunciation.vsix",
    "test:audio": "node scripts/smoke-audio.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vscode/vsce": "4.0.0",
    "eslint": "^10.11.0",
    "yauzl": "3.4.0"
  }
}
