{
  "name": "pronounciation",
  "displayName": "Pronunciation",
  "description": "Read selected text or the word at your cursor aloud using local voices, adjustable speed, and replay.",
  "version": "0.0.2",
  "repository": "https://github.com/zznam/vs-pronounciation.git",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=22.13.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:pronounciation.pronounce",
    "onCommand:pronounciation.stop",
    "onCommand:pronounciation.repeat",
    "onCommand:pronounciation.setSpeed",
    "onCommand:pronounciation.setVoice",
    "onCommand:pronounciation.previewVoice",
    "onCommand:pronounciation.setCustomSpeed",
    "onCommand:pronounciation.faster",
    "onCommand:pronounciation.slower",
    "onCommand:pronounciation.resetSpeed",
    "onCommand:pronounciation.openSettings"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pronounciation.pronounce",
        "title": "Pronunciation: Read Selection or Word"
      },
      {
        "command": "pronounciation.stop",
        "title": "Pronunciation: Stop"
      },
      {
        "command": "pronounciation.repeat",
        "title": "Pronunciation: Replay Last Text"
      },
      {
        "command": "pronounciation.setSpeed",
        "title": "Pronunciation: Set Speed"
      },
      {
        "command": "pronounciation.setVoice",
        "title": "Pronunciation: Choose Installed Voice"
      },
      {
        "command": "pronounciation.previewVoice",
        "title": "Pronunciation: Preview Voice"
      },
      {
        "command": "pronounciation.setCustomSpeed",
        "title": "Pronunciation: Set Custom Speed"
      },
      {
        "command": "pronounciation.faster",
        "title": "Pronunciation: Speak Faster"
      },
      {
        "command": "pronounciation.slower",
        "title": "Pronunciation: Speak Slower"
      },
      {
        "command": "pronounciation.resetSpeed",
        "title": "Pronunciation: Reset Speed"
      },
      {
        "command": "pronounciation.openSettings",
        "title": "Pronunciation: Open Settings"
      }
    ],
    "keybindings": [
      {
        "command": "pronounciation.pronounce",
        "key": "ctrl+alt+p",
        "mac": "cmd+ctrl+p",
        "when": "editorTextFocus"
      },
      {
        "command": "pronounciation.stop",
        "key": "ctrl+alt+s",
        "mac": "cmd+ctrl+s",
        "when": "editorTextFocus"
      },
      {
        "command": "pronounciation.repeat",
        "key": "ctrl+alt+r",
        "mac": "cmd+ctrl+r",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pronounciation.pronounce",
          "group": "9_cutcopypaste@100"
        },
        {
          "command": "pronounciation.stop",
          "when": "pronounciation.speaking",
          "group": "9_cutcopypaste@101"
        }
      ]
    },
    "configuration": {
      "title": "Pronunciation",
      "properties": {
        "pronounciation.voice": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Installed system voice name. Leave empty for the default. On Linux, use a Festival name such as voice_kal_diphone."
        },
        "pronounciation.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 3,
          "scope": "application",
          "description": "Relative speaking speed (0.5 is slower, 1 is normal, 2 is faster). Exact timing depends on the system voice."
        },
        "pronounciation.readWordAtCursor": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Read the word at the cursor when no text is selected."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration/run.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=extension.js --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 test/*.test.js",
    "check": "npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0"
  }
}
